{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["e2e/**/*.ts", "src/core/scripts/jsonTypes/*.ts"],
  "exclude": ["e2e/.cache/**"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  }
}
